# Copy to deploy/.env and fill in. Never commit the real file.

# Your domain, with DNS pointing at this server (Caddy gets the certificate).
DOMAIN=bills.example.com

# Database password (any long random string). Generate with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# Encryption key for uploads and saved results: 32 random bytes, base64. Generate with:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# KEEP A COPY somewhere safe (e.g. a password manager). Saved bills are kept for
# 90 days and cannot be read without this key.
BILLCHECKER_KEY=

# LLM provider. Real bills need a PAID tier: Gemini's free tier may use your data
# to improve Google's products. Use a paid Gemini key or Claude.
BILLCHECKER_PROVIDER=gemini
BILLCHECKER_MODEL=gemini-3.6-flash
GEMINI_API_KEY=
# BILLCHECKER_PROVIDER=claude
# ANTHROPIC_API_KEY=

# Optional licensed reference data (see src/billchecker/reference.py).
# BILLCHECKER_NCCI_FILE=/data/ncci.csv
# BILLCHECKER_PRICES_FILE=/data/prices.csv
# BILLCHECKER_PRICES_LABEL=Medicare national rate (2026)
